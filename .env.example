# Copy required values into .env.local. Do not commit API keys or access codes.
OPENAI_API_KEY=

# Image-to-enemy is off by default. Both flag and key are required.
AI_DEMO_ENABLED=false
# Required in production; share only for supervised previews.
AI_DEMO_ACCESS_TOKEN=
AI_MODEL=gpt-4.1-mini
# Clamped to 20 seconds. No automatic SDK retries.
AI_TIMEOUT_MS=15000
